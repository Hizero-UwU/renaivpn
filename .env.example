# Bot Configuration
BOT_TOKEN=your_telegram_bot_token_here
ADMIN_USER_IDS=123456789,987654321

# Database
DATABASE_URL=postgresql://vpn_user:your_password@localhost:5432/vpn_bot

# Remnwave API
REMNWAVE_API_KEY=your_remnwave_api_key
REMNWAVE_API_URL=https://api.remnwave.com/v1

# Payment Provider (ЮKassa)
YUKASSA_SHOP_ID=your_shop_id
YUKASSA_SECRET_KEY=your_secret_key
YUKASSA_WEBHOOK_SECRET=your_webhook_secret

# Redis (for Celery, optional)
REDIS_URL=redis://localhost:6379/0

# Application
APP_URL=https://yourdomain.com
WEBHOOK_PATH=/webhook/telegram
PAYMENT_WEBHOOK_PATH=/webhook/payment

# Logging
LOG_LEVEL=INFO
